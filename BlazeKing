-- KEY SYSTEM
-- =====================================================
local unlocked = false

local function UnlockPanel()
    if unlocked then return end
    unlocked = true
    if KeyGui then KeyGui:Destroy() end
    ScreenGui.Enabled = true
    print("✅ Ključ pravilen — Admin Panel v8 odklenjen!")
end

local function TryKey()
    if unlocked then return end
    local entered = tostring(KeyInput.Text):gsub("%s", "")
    if entered == KEY then
        KeyStatus.TextColor3 = Color3.fromRGB(80, 220, 80)
        KeyStatus.Text = "✅ Pravilen ključ!"
        KeyButton.BackgroundColor3 = Color3.fromRGB(50, 160, 50)
        task.wait(0.6)
        UnlockPanel()
    else
        KeyStatus.TextColor3 = Color3.fromRGB(255, 80, 80)
        KeyStatus.Text = "❌ Napačen ključ!"
        KeyInput.Text = ""
        local orig = KeyFrame.Position
        for i = 1, 6 do
            KeyFrame.Position = orig + UDim2.new(0, (i % 2 == 0 and 8 or -8), 0, 0)
            task.wait(0.04)
        end
        KeyFrame.Position = orig
    end
end

KeyButton.MouseButton1Click:Connect(TryKey)
KeyInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then TryKey() end
end)

