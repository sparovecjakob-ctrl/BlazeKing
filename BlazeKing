-- INF JUMP — StateChanged listener
-- =====================================================
local infJumpConn

local function StartInfJump()
    if infJumpConn then infJumpConn:Disconnect() end
    infJumpConn = RunService.Heartbeat:Connect(function()
        if not States.InfJump then return end
        local _, hum = GetHumanoid()
        if hum and hum:GetState() == Enum.HumanoidStateType.Freefall then
            pcall(function()
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end)
        end
    end)
end

local function StopInfJump()
    if infJumpConn then infJumpConn:Disconnect() infJumpConn = nil end
end

-- =====================================================
-- FULLBRIGHT — enkratno nastavljanje
-- =====================================================
local originalLighting = {}
local fbConn

local function StartFullbright()
    originalLighting = {
        Brightness = Lighting.Brightness,
        GlobalShadows = Lighting.GlobalShadows,
        Ambient = Lighting.Ambient,
        OutdoorAmbient = Lighting.OutdoorAmbient,
        FogStart = Lighting.FogStart,
        FogEnd = Lighting.FogEnd,
        ClockTime = Lighting.ClockTime
    }
    if fbConn then fbConn:Disconnect() end
    fbConn = RunService.Heartbeat:Connect(function()
        if not States.Fullbright then return end
        pcall(function()
            Lighting.Brightness = 3
            Lighting.GlobalShadows = false
            Lighting.Ambient = Color3.fromRGB(255, 255, 255)
            Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
            Lighting.FogStart = 0
            Lighting.FogEnd = 1000000
            Lighting.ClockTime = 12
            Lighting.ExposureCompensation = 1
        end)
    end)
end

local function StopFullbright()
    if fbConn then fbConn:Disconnect() fbConn = nil end
    for k, v in pairs(originalLighting) do
        pcall(function() Lighting[k] = v end)
    end
end

